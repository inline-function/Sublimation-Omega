// stdlib.collection.list —— 链表 List：**底层件**（纯 List 域——不产 Optional/Set/Map 类型；
// DAG 分层：optional/result/set/map 件挂本件）。结构体/别名 B1 retire 虚拟声明（形状逐字同构）。
// 裸名链（R-23 非限定）只含 retire 替身三项（range/sum/summation——B0-0）+ retire 允许表类型名。
// 产 Optional 的访问器（head/last/elementAt/find/indexOf/maxNat/minNat/get/firstOr）与跨件
// 转换（toSet/toMap）按 DAG 分层移入 optional/set/map 件（差分台账登记）。B1 布局归属不变。

struct Nil

struct Cons[T](head: T, tail: List[T])

type List[T] = Nil | Cons[T]

// t139→t141（R-24 v2 / OQ-4 = b 签名面延续）：add 落体改函数级 @mutable 形态——体**仍空**
// （体随「运行时桥规格」（R4）后续件落；R-15 兑现债登记——提案 §4 裁 b：别写结构性体，
// a 方案在 codegen 数组特判下语义假）。@mutable = @mut @ref 接收者组合的纯糖（R-24 v2）：
// 调用方纯域闸口径同 @mut 方法糖（E-IMPURE-REQUIRED）；提升位注解不入 HIR——两形态 HIR 同源。
// 经 declareModuleExt 注入父域虚拟层：糖渠道接收者头 List 不变（sugarExt/direct 调用面零差分）。
@mutable fun List[a].add[a](e: a): List[a]

// 扩展函数（特质成员 map/fold/pure/flatMap；方法糖 xs.map(f) 与自由式同桶路由，TS-12）。
fun List[a].map[a, b](f: (a) => b): List[b] = when(self) {
    Nil -> Nil
    is Cons(h, t) -> Cons(f(h), t.map(f))
}

fun List[a].fold[a, r](init: r, f: (r, a) => r): r = when(self) {
    Nil -> init
    is Cons(h, t) -> t.fold(f(init, h), f)
}

fun List[a].pure[a](x: a): List[a] = Cons(x, Nil)

fun List[a].flatMap[a, b](f: (a) => List[b]): List[b] = when(self) {
    Nil -> Nil
    is Cons(h, t) -> append(f(h), t.flatMap(f))
}

// ---------- 构造 ----------
fun emptyList[T](): List[T] = Nil

fun cons[T](x: T, xs: List[T]): List[T] = Cons(x, xs)

// t146（R-26.5 / B2.1 构造函数正道）：构造族落 stdlib 源——@list 变长形参（t48/ADR-32）吸收
// 0..n 实参；体随「运行时桥规格」（R4）后续件落（同 B2 扩展方法纪律——别写结构性体）。
fun mutableListOf[T](@list e : T) : @mut List[T]

fun listOf[T](@list e : T) : List[T]

// 区间构造：range(1, 6) = [1, 2, 3, 4, 5]（右开区间；retire 替身 B0-0）。
fun range(a: Nat, b: Nat): List[Nat] {
    if (a < b) {
        unchecked var rest = range(a + 1, b)
        return Cons(a, rest)
    }
    return Nil
}

// ---------- 观察（不含产 Optional 的访问器——移 optional 件）----------
fun size[T](xs: List[T]): Nat = when(xs) {
    Nil -> 0
    is Cons(_, t) -> size(t) + 1
}

fun isEmpty[T](xs: List[T]): Bool = when(xs) {
    Nil -> True
    is Cons(_, _) -> False
}

fun contains[T](xs: List[T], x: T): Bool = when(xs) {
    Nil -> False
    is Cons(h, t) -> if (h == x) { True } else { contains(t, x) }
}

fun count[T](xs: List[T], p: (T) => Bool): Nat = xs.fold(0) { acc, x =>
    if (p(x)) { acc + 1 } else { acc }
}

fun any[T](xs: List[T], p: (T) => Bool): Bool = xs.fold(False) { acc, x =>
    acc | p(x)
}

fun all[T](xs: List[T], p: (T) => Bool): Bool = xs.fold(True) { acc, x =>
    acc & p(x)
}

@impure
fun forEach[T](xs: List[T], f: @impure (T) => Null): Null = when(xs) {
    Nil -> null
    is Cons(h, t) -> { f(h); forEach(t, f) }
}

// ---------- 增删改 ----------
fun append[T](xs: List[T], ys: List[T]): List[T] = when(xs) {
    Nil -> ys
    is Cons(h, t) -> Cons(h, append(t, ys))
}

fun take[T](xs: List[T], n: Nat): List[T] = when(xs) {
    Nil -> Nil
    is Cons(h, t) ->
        if (n == 0) { Nil }
        else { unchecked var r = take(t, n - 1); Cons(h, r) }
}

fun drop[T](xs: List[T], n: Nat): List[T] = when(xs) {
    Nil -> Nil
    is Cons(_, t) ->
        if (n == 0) { xs }
        else { unchecked var r = drop(t, n - 1); r }
}

// 区间切片：slice(xs, 1, 3) 取 [1, 3) 段（from 含、to 不含）。
// 实现：take(to) + drop(from) 复合（e2e 原文递推 `to - 1` 落 Int——Nat 减法 Int 化；本件零红）。
fun slice[T](xs: List[T], from: Nat, to: Nat): List[T] = drop(take(xs, to), from)

fun filter[T](xs: List[T], p: (T) => Bool): List[T] = when(xs) {
    Nil -> Nil
    is Cons(h, t) -> if (p(h)) { Cons(h, filter(t, p)) } else { filter(t, p) }
}

fun distinct[T](xs: List[T]): List[T] = when(xs) {
    Nil -> Nil
    is Cons(h, t) -> if (contains(t, h)) { distinct(t) } else { Cons(h, distinct(t)) }
}

fun sortBy[T](xs: List[T], f: (T, T) => Bool): List[T] = when(xs) {
    Nil -> Nil
    is Cons(h, t) -> insertSort(h, sortBy(t, f), f)
}

// 插入排序的一步：f(a, b) 为「a 应排在 b 前」的序谓词。
fun insertSort[T](x: T, xs: List[T], f: (T, T) => Bool): List[T] = when(xs) {
    Nil -> Cons(x, Nil)
    is Cons(h, t) -> if (f(x, h)) { Cons(x, Cons(h, t)) } else { Cons(h, insertSort(x, t, f)) }
}

// 反转：reverse([1, 2, 3]) = [3, 2, 1]。
fun reverse[T](xs: List[T]): List[T] = when(xs) {
    Nil -> Nil
    is Cons(h, t) -> append(reverse(t), Cons(h, Nil))
}

fun clear[T](xs: List[T]): List[T] = Nil

// ---------- 聚合 ----------
fun sum(xs: List[Nat]): Nat = xs.fold(0) { acc, x => acc + x }

fun joinToString[T](xs: List[T], sep: Str): Str = xs.fold("") { acc, x =>
    if (acc == "") { toStr(x) } else { concat(acc, concat(sep, toStr(x))) }
}

// ---------- 转换 ----------
fun zip[A, B](xs: List[A], ys: List[B]): List[(A, B)] = when(xs) {
    Nil -> Nil
    is Cons(h, t) -> when(ys) {
        Nil -> Nil
        is Cons(h2, t2) -> Cons((h, h2), zip(t, t2))
    }
}
