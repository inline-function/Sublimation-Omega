// stdlib.collection.optional —— Optional[T] 自由函数全家（B0-1 迁源；e2e core/collection/optional 同构）
// 依赖：Some/None/Optional/Ok/Err/Result/List/Nil/Cons 经 prelude 虚拟声明（名义同构，B1 后同源）；
// 本件无跨件函数依赖（e2e 形态直迁）。

// 扩展函数（特质成员 map/fold/pure/flatMap；self 绑定接收者，TS-10）。
fun Optional[a].map[a, b](f: (a) => b): Optional[b] = when(self) {
    is Some(v) -> Some(f(v))
    None -> None
}

fun Optional[a].fold[a, r](init: r, f: (r, a) => r): r = when(self) {
    is Some(v) -> f(init, v)
    None -> init
}

fun Optional[a].pure[a](x: a): Optional[a] = Some(x)

fun Optional[a].flatMap[a, b](f: (a) => Optional[b]): Optional[b] = when(self) {
    is Some(v) -> f(v)
    None -> None
}

// ---------- 判定与解构 ----------
fun isSome[T](o: Optional[T]): Bool = when(o) {
    is Some(_) -> True
    None -> False
}

fun isNone[T](o: Optional[T]): Bool = when(o) {
    is Some(_) -> False
    None -> True
}

// 取值兜底：None 回退默认值（替代已移除的 ?: 空替代语法）。
fun getOrElse[T](o: Optional[T], d: T): T = when(o) {
    is Some(v) -> v
    None -> d
}

// 空替代：None 时切换到另一个 Optional（不改变 Some 的内容）。
fun orElse[T](o: Optional[T], d: Optional[T]): Optional[T] = when(o) {
    is Some(_) -> o
    None -> d
}

// 过滤：谓词不成立时降级为 None。
fun filter[T](o: Optional[T], p: (T) => Bool): Optional[T] = when(o) {
    is Some(v) -> if (p(v)) { Some(v) } else { None }
    None -> None
}

fun toResult[T, E](o: Optional[T], e: E): Result[T, E] = when(o) {
    is Some(v) -> Ok(v)
    None -> Err(e)
}

fun toList[T](o: Optional[T]): List[T] = when(o) {
    is Some(v) -> Cons(v, Nil)
    None -> Nil
}
