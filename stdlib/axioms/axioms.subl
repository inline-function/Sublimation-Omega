// stdlib.axioms —— 公理库（B3 / 标准库规划 §3 首批清单）。
//
// 定位：语言定义层的**规格面**（spec of record）——公理只登记不证明（R-AXIOM）。
// 编译期擦除为 Null（无体签名 = 公理声明）;凡体可由内建快路径给的事实（如 Nat 非负，
// t65 provenance=type 注入）与本库的公理做的是同一件事——公理库为规格，注入为实现，
// 一致性（注入事实 ⊆ 公理可实例化）为后续件（规划 §6 Q2/路线②③）。
//
// 形态约束（诚实边界）:
// - 类型判定位（∀n : Nat 的 n : Nat）按 ADR-13 §三 推迟——公理以**命题元变量** [n] 形态落，
//   类型约束由调用位类型事实补（与 e2e core/logic 同一妥协）;
// - 命题项自由名（length / Nil / Cons / append）走命题位静默模式（未知 schematic 变量），
//   故本件**无依赖挂载**（公理不断言 stdlib 的符号解析，只断言其数学含义）;
// - 归纳法依赖面（L5–L7 长度不变性族 / reverse 不动点 / E1–E3 外延性、排序正确性、
//   induction 公理）按 t91 裁决 6 暂缓——归纳法落地后由「公理」降为「定理」。
// - t157（B3 后续件）：M/S/T/G 四族八条评估后**可落**（现行命题形全通——函数应用/
//   构造子应用/真值与字符串字面量/区间项 ∈/lo..hi），已落下方四族;归纳法面仍暂缓。
// - 跨模块命题实例化通道（t157 收口 + 既有边界登记）:
//   · 限定 callee 角表（mod.f[Nat](x) 类型实参 / mod.f<p>() 命题供给，被调含 PropParam
//     理论参数时）**已通**（t157 Elaborator 收口——修前两路皆红：[] 按值域读双错、<> 兜底）;
//   · 数值公理形（本库 [n] 元变量 + posts）不经调用注入（R-26.1/t148 既有口径）——
//     posts 的跨件检查仅声明侧（快照无命题面），用户实例化以 axiom 语句 / by 断言就地写。
//   · 注入一致性（t157 落 T157AxiomsConsistencyTest：axioms 修改即报差，防静默漂移）——
//     类型注入（D-NAT-PROP 的 n >= 0）与 A1 声明同一断言：快路径与规格分家但口径对应。

// ---------- 数值（A1–A3）----------

// A1：Nat 非负（用户点名的原型公理——规划 §1/§3.1）。
@axiom
fun `nat non-negative`[n]: Null <n >= 0>

// A2：Nat 加法单调（无界加法不回绕）。
@axiom
fun `nat add monotone`[n, m]: Null <(n + m) >= n>

// A3：Nat 减法非负充要（减法收窄的根据，ST-10.2）。
@axiom
fun `nat sub non-negative`[n, m]: Null <((n - m) >= 0) ↔ (n >= m)>

// ---------- 链表（L1–L4：证明需归纳 ⇒ 公理）----------

// L1：空表长度为零。
@axiom
fun `list length nil`: Null <length(Nil) = 0>

// L2：Cons 长度递推（定义性，V1 无展开机制 ⇒ 公理）。
@axiom
fun `list length cons`[h, t]: Null <length(Cons(h, t)) = 1 + length(t)>

// L3a：右单位元。
@axiom
fun `list append nil`[xs]: Null <append(xs, Nil) = xs>

// L3b：结合律。
@axiom
fun `list append assoc`[xs, ys, zs]: Null <append(append(xs, ys), zs) = append(xs, append(ys, zs))>

// L4：长度可加（实用度极高）。
@axiom
fun `list length append`[xs, ys]: Null <length(append(xs, ys)) = length(xs) + length(ys)>


// ---------- t157（B3 后续件·M/S/T/G 扩容）：四族八条 ----------
// 评估结论（先行探测后落，零强造）：四族命题形在现行语言形态下**全部可写**——
// 函数应用（get/put/insert/contains/concat）、构造子应用（Some(v)）、真值字面量 True、
// 字符串字面量 ""、区间项 lo..hi 与 ∈ 原子经命题位静默模式解析（NameResolver 既有口径）。
// M 族（Map 查找-插入律 / 异键不扰）——自由名接 stdlib map 件函数面（put/get）。
@axiom
fun `map get put`[m, k, v]: Null <get(put(m, k, v), k) = Some(v)>

@axiom
fun `map put other key`[m, k1, k2, v]: Null <(k1 != k2) → (get(put(m, k1, v), k2) = get(m, k2))>

// S 族（Set 插入自含 / 异元不扰）——自由名接 stdlib set 件函数面（insert/contains）。
@axiom
fun `set insert contains`[s, x]: Null <contains(insert(s, x), x) = True>

@axiom
fun `set insert other`[s, x, y]: Null <(x != y) → (contains(insert(s, x), y) = contains(s, y))>

// T 族（文本长度可加 / 结合律 / 空串单位元）——concat/length 自由名（stdlib 件未含文本操作，
// 按规划 §3.3 以规格先行落，函数面随核心库迁入）。
@axiom
fun `text length concat`[a, b]: Null <length(concat(a, b)) = length(a) + length(b)>

@axiom
fun `text concat assoc`[a, b, c]: Null <concat(concat(a, b), c) = concat(a, concat(b, c))>

@axiom
fun `text concat empty`[a]: Null <concat(a, "") = a>

// G 族（区间成员等价）——∈ 原子 + 区间项（lo..hi）与 e2e logic/inequality 同口径。
// V1 取闭区间口语（lo <= x ∧ x <= hi）;半开/闭合最终语义随 P-11 区间定案校准（规划 §3.5 注）。
@axiom
fun `range membership`[x, lo, hi]: Null <(x ∈ (lo..hi)) ↔ ((lo <= x) ∧ (x <= hi))>
