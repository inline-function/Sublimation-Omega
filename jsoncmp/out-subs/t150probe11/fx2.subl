// ============================================================
// 特性：副作用与 unchecked（@impure / @root 副作用闸 / unchecked 单语句豁免 / 参数位深拷隔离 R-17）
// 预期输出见行尾注释
// ============================================================

@impure fun impureAppend(xs : @mut List[Nat]): Null {
    unchecked xs.add(1)
}

@root fun rootZero(): Null {
    unchecked print("root")    // @root 让纯侧可调本函数；体内 print 仍单独走 unchecked
}

@impure fun impureZero(): Null {
    print("impure")
}

fun pureWrap(): Null {
    unchecked impureZero()      // unchecked 前缀：单语句局部豁免 E-IMPURE-CALL
}

@impure fun main() {
    var xs : @mut List[Nat] = mutableListOf(0)
    impureAppend(xs)           // R-28：MUT→MUT 参数位深拷隔离（R-17——构造族源合法格）
    impureAppend(xs)
    print(xs)                  // [0]（两次 append 各深拷，原值不动）
    rootZero()                  // @root 闸口
    pureWrap()                  // unchecked 豁免
    print("done")
}
