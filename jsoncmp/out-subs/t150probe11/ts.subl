// ============================================================
// 特性：类型系统（类型别名 / @mut @ref 拷贝矩阵 / 联合视角）
// 预期输出见行尾注释
// ============================================================

type Age = Nat

@mut struct Box(@mut n: Nat)

@impure fun main() {
    var age : Age = 18
    print(age)                            // 18（别名互通）

    // 拷贝矩阵：@ref 目标共享；@mut 目标深拷；@ref @mut 目标对 @mut 源别名
    var s : Box = Box(1)
    @mut var t : Box = s                  // @mut 目标 ← 纯源：深拷
    t.n = 2
    print(s.n)                            // 1
    print(t.n)                            // 2

    @mut var o : Box = Box(3)
    @ref var view : Box = o               // @ref 目标：共享只读视图
    o.n = 4
    print(view.n)                         // 4

    var p : @mut List[Nat] = mutableListOf(5)
    @ref var q : @mut List[Nat] = p      // @ref @mut ← MUT：别名共享（R-28：真 @mut 源唯构造族）
    unchecked p.add(1)
    print(q)                             // [5, 1]
    print("done")
}