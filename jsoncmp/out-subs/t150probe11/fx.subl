// ============================================================
// 特性：副作用与 unchecked（@impure / @root 副作用闸 / unchecked 单语句豁免 / 参数位深拷隔离 R-17）
// 预期输出见行尾注释
// ============================================================

@mut struct Counter(@mut v: Nat)

@impure fun impureBump(c: @mut Counter): Null {
    c.v = c.v + 1
}

@root fun rootZero(): Null {
    unchecked print("root")    // @root 让纯侧可调本函数；体内 print 仍单独走 unchecked
}

@impure fun impureZero(): Null {
    print("impure")
}

fun pureWrap(): Null {
    unchecked impureZero()      // unchecked 前缀：单语句局部豁免 E-IMPURE-CALL
}

@impure fun main() {
    @mut var ct = Counter(0)
    unchecked impureBump(ct)    // R-28：参数位 PLAIN→MUT 深拷格废止——构造族源经 unchecked 闸演示（R-17 隔离义保留）
    unchecked impureBump(ct)
    print(ct.v)                 // 0（两次 bump 各隔离，原值不动）
    rootZero()                  // @root 闸口
    pureWrap()                  // unchecked 豁免
    print("done")
}
